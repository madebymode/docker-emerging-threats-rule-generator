# AppArmor profile for ETR self-update (etr-update.service sets AppArmorProfile=).
# Local additions: /etc/apparmor.d/local/etr-update
#include <tunables/global>

profile etr-update flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  # The only profile that may replace the binary. It runs the new binary
  # once with --version before installing it.
  /opt/etr/bin/ r,
  /opt/etr/bin/etr-linux mrwix,
  /opt/etr/bin/etr-linux.prev rw,
  /opt/etr/bin/.etr-update-* mrwix,

  # Find the daemon, check which binary it runs, ask it to re-exec.
  /var/lib/etr/ r,
  /var/lib/etr/etr.pid r,
  @{PROC}/@{pids}/exe r,
  ptrace (read) peer=etr-daemon,
  signal (send) set=(hup) peer=etr-daemon,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  /sys/fs/cgroup/** r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  #include <local/etr-update>
}
