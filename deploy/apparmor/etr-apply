# AppArmor profile for etr-apply, the root installer. Attached by path and by
# etr-apply.service. Local additions (e.g. a custom ETR_LIVE_FILE, or nginx
# logs outside /var/log): /etc/apparmor.d/local/etr-apply
#include <tunables/global>

profile etr-apply /usr/local/sbin/etr-apply flags=(attach_disconnected) {
  #include <abstractions/base>

  capability chown,
  capability dac_read_search,
  capability fowner,

  /usr/local/sbin/etr-apply mr,

  # The staged list. No access to anything else the daemon writes.
  /var/lib/etr/ r,
  /var/lib/etr/blocklist.conf r,

  /var/lib/etr-apply/ rw,
  /var/lib/etr-apply/** rw,

  # The live include, written through a temp file in the same directory.
  /etc/nginx/conf.d/ r,
  /etc/nginx/conf.d/blocklist.conf rw,
  /etc/nginx/conf.d/.etr-apply-* rw,
  /etc/nginx-sp/http.d/ r,
  /etc/nginx-sp/http.d/etr-blocklist.conf rw,
  /etc/nginx-sp/http.d/.etr-apply-* rw,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  /sys/fs/cgroup/** r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  /{usr/,}{s,}bin/nginx Cx -> nginx_test,
  /{usr/,}{s,}bin/nginx-sp Cx -> nginx_test,
  /{usr/,}bin/systemctl Cx -> systemctl,

  # `nginx -t` must read every config file and TLS key and open every log,
  # so it gets read access to /etc and write access to logs only. etr-apply
  # itself can read neither.
  profile nginx_test flags=(attach_disconnected) {
    #include <abstractions/base>
    #include <abstractions/nameservice>
    #include <abstractions/ssl_certs>
    #include <abstractions/ssl_keys>

    capability chown,
    capability dac_override,
    capability dac_read_search,
    capability setgid,
    capability setuid,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,

    /{usr/,}{s,}bin/nginx mr,
    /{usr/,}{s,}bin/nginx-sp mr,
    /usr/lib/nginx/** mr,
    /usr/lib/nginx-sp/** mr,
    /usr/share/nginx/** r,
    /etc/** r,
    /var/log/** rwk,
    /srv/users/*/log/** rwk,
    /var/lib/nginx/** rwk,
    /var/cache/nginx/** rwk,
    /run/nginx*.pid r,
    /usr/share/GeoIP/** r,
  }

  # `systemctl reload-or-restart <nginx unit>` over systemd's private socket.
  profile systemctl flags=(attach_disconnected) {
    #include <abstractions/base>

    /{usr/,}bin/systemctl mr,
    /run/systemd/private rw,
    /run/systemd/** r,
    /etc/systemd/** r,
    /{usr/,}lib/systemd/** r,
    @{PROC}/** r,
    /sys/fs/cgroup/** r,
    unix (connect, send, receive) type=stream,
  }

  #include <local/etr-apply>
}
