[Unit]
Description=Check for signed ETR releases without installing software
Documentation=https://github.com/madebymode/docker-emerging-threats-rule-generator/blob/master/native-install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=etr
Group=etr
ExecStart=/opt/etr/bin/etr-linux --check-update
EnvironmentFile=-/etc/etr/etr.env
# The daemon profile/domain allows notifications and state, never binary writes.
AppArmorProfile=-etr-daemon
StateDirectory=etr
StateDirectoryMode=0750
UMask=0077
# Also bounds an unresponsive notification backend (including SMTP).
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=etr-check-update

# Hardening. Directives newer than the host's systemd (RHEL 8 has 239) are
# skipped with a warning in the journal.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

