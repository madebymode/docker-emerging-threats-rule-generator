[Unit]
Description=Emerging Threats Rule Generator (ServerPilot, self-scheduling daemon)
Documentation=https://github.com/madebymode/docker-emerging-threats-rule-generator/blob/master/native-install.md
After=network-online.target nginx-sp.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/etr-linux
Restart=on-failure
RestartSec=60s

# Daemon mode: the binary self-schedules its own runs (default 03:00 local
# with up to 60min jitter). Use `etr-linux --force` for an immediate run.
Environment=ETR_DAEMON=true

# ServerPilot-specific paths and service name.
# Set nginx_conf_file_path in /etc/etr/config.json to:
#   /etc/nginx-sp/http.d/etr-blocklist.conf
# http.d is ServerPilot's http-level include directory. Not vhosts.d/APPNAME.d/:
# that is included inside a server block, where nginx rejects the geo block.
Environment=NGINX_CONF_DIR=/etc/nginx-sp/http.d
Environment=NGINX_SERVICE=nginx-sp

EnvironmentFile=-/etc/etr/etr.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=etr

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/etc/nginx-sp/http.d /etc/etr
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
