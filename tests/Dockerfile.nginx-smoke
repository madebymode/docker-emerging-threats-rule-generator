ARG ETR_IMAGE=etr:hardening-test
FROM ${ETR_IMAGE} AS rules
COPY --chown=etr-updater:etr-updater tests/nginx-fixture.json /app/config.json
RUN RESTART_CONTAINERS=false /usr/local/bin/nginx_blacklist --force

FROM nginxinc/nginx-unprivileged:alpine-slim
COPY --from=rules /app/nginx/conf/blocklist.conf /etc/nginx/conf.d/blocklist.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY tests/nginx-smoke.conf /etc/nginx/conf.d/test-only.conf
COPY tests/nginx-smoke.sh /smoke.sh
ENTRYPOINT ["sh", "/smoke.sh"]
